/*
 * R36S clone overclock OPPs, based on the 4.4 rk3326-oc.dtsi.
 * Include from the selected board DTS only.
 *
 * The 5.10 clock and DDR firmware expose 600 MHz GPU and 1032 MHz DMC.
 * The 4.4 640/1040 MHz requests resolve to these physical rates, so do not
 * add duplicate nominal OPPs.
 */

&cpu0_opp_table {
	rockchip,max-volt = <1400000>;

	opp-1368000000 {
		opp-hz = /bits/ 64 <1368000000>;
		opp-microvolt = <1350000 1350000 1350000>;
		opp-microvolt-L0 = <1350000 1350000 1350000>;
		opp-microvolt-L1 = <1350000 1350000 1350000>;
		opp-microvolt-L2 = <1300000 1300000 1350000>;
		opp-microvolt-L3 = <1250000 1250000 1350000>;
		clock-latency-ns = <40000>;
	};
	opp-1440000000 {
		opp-hz = /bits/ 64 <1440000000>;
		opp-microvolt = <1350000 1350000 1350000>;
		opp-microvolt-L0 = <1350000 1350000 1350000>;
		opp-microvolt-L1 = <1350000 1350000 1350000>;
		opp-microvolt-L2 = <1300000 1300000 1350000>;
		opp-microvolt-L3 = <1250000 1250000 1350000>;
		clock-latency-ns = <40000>;
	};
	opp-1464000000 {
		opp-hz = /bits/ 64 <1464000000>;
		opp-microvolt = <1350000 1350000 1350000>;
		opp-microvolt-L0 = <1350000 1350000 1350000>;
		opp-microvolt-L1 = <1350000 1350000 1350000>;
		opp-microvolt-L2 = <1300000 1300000 1350000>;
		opp-microvolt-L3 = <1250000 1250000 1350000>;
		clock-latency-ns = <40000>;
	};
	opp-1488000000 {
		opp-hz = /bits/ 64 <1488000000>;
		opp-microvolt = <1350000 1350000 1350000>;
		opp-microvolt-L0 = <1350000 1350000 1350000>;
		opp-microvolt-L1 = <1350000 1350000 1350000>;
		opp-microvolt-L2 = <1300000 1300000 1350000>;
		opp-microvolt-L3 = <1250000 1250000 1350000>;
		clock-latency-ns = <40000>;
	};
	opp-1608000000 {
		opp-hz = /bits/ 64 <1608000000>;
		opp-microvolt = <1350000 1350000 1350000>;
		opp-microvolt-L0 = <1350000 1350000 1350000>;
		opp-microvolt-L1 = <1350000 1350000 1350000>;
		opp-microvolt-L2 = <1300000 1300000 1350000>;
		opp-microvolt-L3 = <1250000 1250000 1350000>;
		clock-latency-ns = <40000>;
	};
};

&gpu_opp_table {
	opp-600000000 {
		opp-hz = /bits/ 64 <600000000>;
		opp-microvolt = <1175000>;
		opp-microvolt-L0 = <1175000>;
		opp-microvolt-L1 = <1175000>;
		opp-microvolt-L2 = <1175000>;
		opp-microvolt-L3 = <1175000>;
	};
};

&dmc_opp_table {
	opp-924000000 {
		opp-hz = /bits/ 64 <924000000>;
		opp-microvolt = <1175000>;
		opp-microvolt-L0 = <1175000>;
		opp-microvolt-L1 = <1175000>;
		opp-microvolt-L2 = <1175000>;
		opp-microvolt-L3 = <1175000>;
	};
	/* Trusted firmware realizes the 4.4 tree's 1040 MHz request as 1032 MHz. */
	opp-1032000000 {
		opp-hz = /bits/ 64 <1032000000>;
		opp-microvolt = <1200000>;
		opp-microvolt-L0 = <1200000>;
		opp-microvolt-L1 = <1200000>;
		opp-microvolt-L2 = <1200000>;
		opp-microvolt-L3 = <1200000>;
	};
};
